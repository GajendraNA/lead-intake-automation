# Neon connection strings. Use the DIRECT ones (Connection pooling OFF).
# Copy this file to .neon.env and paste them in. .neon.env stays on your machine.
NEON_N8N_URL='postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/n8n?sslmode=require'
NEON_LEADS_URL='postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/leads?sslmode=require'
