# Copy to .env and fill in. Never commit .env to Git.

# --- Database ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_run_openssl_rand_-base64_24

# --- n8n secrets ---
# Generate once with: openssl rand -hex 32
# Never change it after you save credentials in n8n, and keep a copy in a password manager.
# Without this key, restored credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_-hex_32

# Pin a tested version for client installs (for example 1.x.y) instead of latest.
N8N_IMAGE_TAG=latest
GENERIC_TIMEZONE=Asia/Kolkata

# --- Local development (default) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# --- Production (comment out the local block above and use these) ---
# N8N_HOST=n8n.example.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.example.com/
# N8N_SECURE_COOKIE=true

# --- Mode ---
# regular = single process. queue = main + Redis + workers (also set COMPOSE_PROFILES below).
EXECUTIONS_MODE=regular
# Profiles to start: queue, proxy, or both (comma-separated). Leave empty for simple local mode.
# Examples: COMPOSE_PROFILES=proxy   or   COMPOSE_PROFILES=queue,proxy
COMPOSE_PROFILES=
